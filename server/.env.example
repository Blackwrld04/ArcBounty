# ArcBounty Real Email & Server Configuration

# ==============================================================================
# OPTION 1: Real Gmail Delivery (Free, takes 60 seconds)
# ==============================================================================
# 1. Go to your Google Account -> Security: https://myaccount.google.com/security
# 2. Make sure "2-Step Verification" is ON.
# 3. Search or navigate to "App passwords": https://myaccount.google.com/apppasswords
# 4. Create an app named "ArcBounty" and copy the 16-character password generated.
# 5. Paste them below:
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ==============================================================================
# OPTION 2: Resend (Alternative modern email API)
# ==============================================================================
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ==============================================================================
# OPTION 3: Custom SMTP Provider (SendGrid, Mailgun, Brevo, AWS SES)
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=

# Server Ports & Chain Config
PORT=4050
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
